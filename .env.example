# ==== Elasticsearch ====
ES_URL=http://localhost:9200
ES_USER=
ES_PASSWORD=
ES_INDEX_PREFIX=copilot_hv
ES_ILM_POLICY_ID=copilot_hv-retention

# ==== GitHub Copilot usage metrics (enterprise scope) ====
# Fine-grained app token with "View Enterprise Copilot Metrics" permission
# OR classic PAT with read:enterprise / manage_billing:copilot scopes
GH_TOKEN=
GH_API_BASE=https://api.github.com
GH_ENTERPRISE=
GH_ORGS=

# ==== Bitbucket (REST API 2.0) ====
# App password or OAuth token. Read-only is enough.
BITBUCKET_TOKEN=
BITBUCKET_WORKSPACE=
BITBUCKET_API_BASE=https://api.bitbucket.org/2.0
# Optional: comma separated repo slugs (otherwise discovered via the workspace)
BITBUCKET_REPOS=

# ==== Jira (REST API 3) ====
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEYS=
JIRA_JQL_EXTRA=

# ==== Identity ====
IDENTITY_CSV=data/identity/identity.csv

# ==== Payroll / finance (es_payroll and es_finance collectors) ====
PAYROLL_CSV=data/payroll.csv
FINANCE_PRODUCTS_CSV=data/finance_products.csv
# Optional: data/finance_actuals.csv (product,day,amount_usd,tokens_m) overlays real spend

# ==== Execution ====
COLLECTOR_DRY_RUN=false
BASELINE_DAYS=180

# ==== Scenario tag stamped on every document (dashboard filter) ====
# real = production (default) | good = synthetic high-ROI | bad = synthetic low-ROI
COPILOT_HV_SCENARIO=real